---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Thumb from '../../components/Thumb.astro';
import Card from '../../components/Card.astro';
import { sectionName } from '../../data/sections';

export async function getStaticPaths() {
  const memos = await getCollection('memos', ({ data }) => !data.draft);
  return memos.map((memo) => ({ params: { slug: memo.slug }, props: { memo, all: memos } }));
}
const { memo, all } = Astro.props;
const { Content } = await memo.render();
const d = memo.data;
const date = d.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const related = all
  .filter((m) => m.slug !== memo.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base title={d.title} description={d.summary}>
  <article class="container post">
    <p class="crumb"><a href={`/sections/${d.section}/`}>{sectionName(d.section)}</a></p>
    <h1>{d.title}</h1>
    <p class="byline">Ye Zheng <span aria-hidden="true">|</span> <time datetime={d.date.toISOString()}>{date}</time></p>
    <div class="hero"><Thumb src={d.thumbnail} section={d.section} /></div>
    <div class="prose"><Content /></div>
    <p class="back"><a href="/">Back to all insights</a></p>
  </article>
  {related.length > 0 && (
    <section class="container related">
      <h2>More insights</h2>
      <div class="rgrid">{related.map((m) => <Card memo={m} />)}</div>
    </section>
  )}
</Base>
<style>
  .post { max-width: 760px; padding-top: 56px; }
  .crumb { margin: 0 0 12px; font-size: 14px; font-weight: 600; }
  .crumb a { color: var(--accent); text-decoration: none; }
  h1 { font-family: var(--serif); font-weight: 600; font-size: clamp(32px, 4.6vw, 46px); margin: 0 0 14px; }
  .byline { margin: 0 0 32px; color: var(--muted); font-size: 15px; }
  .hero { margin-bottom: 40px; }
  .prose { font-family: var(--serif); font-size: 19px; line-height: 1.75; }
  .prose :global(p) { margin: 0 0 1.2em; }
  .prose :global(h2) { font-family: var(--serif); font-size: 27px; margin: 1.8em 0 .6em; }
  .prose :global(ol), .prose :global(ul) { padding-left: 1.3em; margin: 0 0 1.2em; }
  .prose :global(li) { margin-bottom: .4em; }
  .prose :global(img) { border-radius: 4px; margin: 1.5em 0; }
  .prose :global(a) { color: var(--accent); }
  .back { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--line); }
  .back a { color: var(--accent); font-weight: 500; }
  .related { padding-top: 72px; }
  .related h2 { font-family: var(--serif); font-size: 26px; margin: 0 0 28px; }
  .rgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 40px 32px; }
</style>
